---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<div class="container">
			<img src="/logo.svg" alt="Twin Pixels Logo" class="logo" />
			<h1>Twin Pixels, LLC</h1>
			<!-- <p class="tagline">Forging new mobile adventures</p> -->
			<a href="mailto:info@twinpixels.gg" class="contact">info@twinpixels.gg</a>
		</div>
	</main>
</Layout>

<style>
	main {
		width: 100%;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		box-sizing: border-box;
	}

	.container {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 600px;
	}

	.logo {
		width: 100%;
		max-width: 300px;
		height: auto;
		margin-bottom: 2rem;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		margin: 0 0 1rem 0;
		letter-spacing: -0.02em;
	}

	.tagline {
		font-size: 1.25rem;
		font-weight: 300;
		margin: 0 0 2rem 0;
		color: #D1D5DB;
	}

	.contact {
		font-size: 1.125rem;
		color: #FFFFFF;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-bottom-color 0.2s ease;
	}

	.contact:hover {
		border-bottom-color: #00DC82;
	}

	@media (max-width: 640px) {
		h1 {
			font-size: 2rem;
		}

		.tagline {
			font-size: 1.125rem;
		}

		.logo {
			max-width: 250px;
		}
	}
</style>
