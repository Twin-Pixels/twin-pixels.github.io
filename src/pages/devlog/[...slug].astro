---
import { render } from 'astro:content';
import DevlogLayout from '../../layouts/DevlogLayout.astro';
import { getPosts, projectNames, formatDate } from '../../lib/devlog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<DevlogLayout title={`${post.data.title} | Twin Pixels devlog`} description={post.data.summary} image={post.data.cover} imageAlt={post.data.coverAlt}>
  <article>
    <header class="head">
      <p class="meta">
        {post.data.projects.map((p) => <span class={p}>{projectNames[p]}</span>)}
        <span class="date">{formatDate(post.data.date)}</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
    </header>
    {post.data.cover && (
      <figure class="cover"><img src={post.data.cover} alt={post.data.coverAlt ?? ''} /></figure>
    )}
    <div class="prose"><Content /></div>
  </article>

  <nav class="pager" aria-label="Other posts">
    {older ? <a href={`/devlog/${older.id}/`}>← {older.data.title}</a> : <span></span>}
    {newer && <a href={`/devlog/${newer.id}/`}>{newer.data.title} →</a>}
  </nav>
</DevlogLayout>

<style>
  .head { max-width: 880px; display: flex; flex-direction: column; gap: 20px; margin-bottom: 48px; }
  .meta { margin: 0; display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; text-transform: uppercase; letter-spacing: .16em; }
  .kindred { color: #00e676; }
  .driftstone { color: #00b0ff; }
  .date { color: #8a9692; }
  h1 { margin: 0; font-family: 'Alegreya', Georgia, serif; font-weight: 400; font-size: clamp(44px, 6.5vw, 88px); line-height: 1; letter-spacing: -.035em; }
  .summary { margin: 0; font-size: 20px; line-height: 1.6; color: #d3d8d3; max-width: 640px; }
  .cover { margin: 0 0 56px; }
  .cover img { width: 100%; max-height: 640px; object-fit: cover; border-radius: 4px; display: block; }
  .prose { max-width: 680px; margin: 0 auto; font-size: 19px; line-height: 1.7; color: #e3e6e1; }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(h2) { margin: 56px 0 16px; font-family: 'Alegreya', Georgia, serif; font-weight: 400; font-size: 40px; line-height: 1.1; letter-spacing: -.025em; color: #f4f3ec; }
  .prose :global(h3) { margin: 36px 0 12px; font-size: 22px; color: #f4f3ec; }
  .prose :global(a) { color: #00e676; }
  .prose :global(img), .prose :global(video) { width: 100%; height: auto; border-radius: 4px; display: block; margin: 32px 0; box-shadow: 0 0 0 1px rgb(244 243 236 / 12%); }
  .prose :global(blockquote) { margin: 28px 0; padding: 0 0 0 20px; border-left: 2px solid #00b0ff; color: #d3d8d3; }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; margin: 0 0 20px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(code) { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .85em; background: #0e1517; padding: 2px 6px; border-radius: 3px; }
  .prose :global(pre) { margin: 24px 0; padding: 20px 22px; background: #0e1517; border-radius: 4px; box-shadow: 0 0 0 1px rgb(244 243 236 / 10%); overflow-x: auto; font-size: 14px; line-height: 1.6; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid rgb(244 243 236 / 18%); margin: 48px 0; }
  .pager { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-top: 64px; padding-top: 28px; border-top: 1px solid rgb(244 243 236 / 20%); font-size: 15px; }
  .pager a { text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .pager a:hover { color: #00e676; }
</style>
