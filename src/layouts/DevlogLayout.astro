---
import Layout from './Layout.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}
const { title = 'Devlog | Twin Pixels', description = 'What changed in Kindred and Driftstone this week.', image, imageAlt } = Astro.props;
const year = new Date().getUTCFullYear();
// Unlisted until the devlog is announced: public, but kept out of search results.
const noindex = true;
---

<Layout title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex}>
  <div class="shell">
    <header>
      <a class="brand" href="/" aria-label="Twin Pixels home">
        <img src="/logo.svg" width="36" height="36" alt="" />
        <span>Twin Pixels</span>
      </a>
    </header>
    <main><slot /></main>
    <footer>
      <span>© {year} Twin Pixels, LLC</span>
      <a class="contact" href="mailto:info@twinpixels.gg">Get in touch <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
    </footer>
  </div>
</Layout>

<style>
  .shell { min-height: 100svh; display: flex; flex-direction: column; padding: 42px clamp(24px, 5vw, 88px) 26px; gap: 72px; }
  header, footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 16px; text-decoration: none; text-transform: uppercase; letter-spacing: .17em; font-size: 17px; }
  main { flex: 1; }
  footer { border-top: 1px solid rgb(244 243 236 / 20%); padding-top: 20px; font-size: 13px; color: #bfc7c3; }
  .contact { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; line-height: 1; text-decoration: none; padding: 12px 0; }
  .contact svg { display: block; flex: none; color: #00e676; }
  .contact:hover { color: #00e676; }
  @media (max-width: 600px) {
    .shell { padding-top: 28px; gap: 48px; }
    .brand { font-size: 13px; gap: 12px; letter-spacing: .12em; }
    .brand img { width: 30px; height: 30px; }
  }
</style>
